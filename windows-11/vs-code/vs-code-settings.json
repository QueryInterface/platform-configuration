{
    "workbench.tree.indent": 15,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.colorCustomizations": {
        "tree.indentGuidesStroke": "#00ff00"
    },
    "git.autofetch": true,
    "security.workspace.trust.untrustedFiles": "open",
    "editor.unicodeHighlight.invisibleCharacters": false,
    "workbench.editorAssociations": {
        "*.svg": "default"
    },
    "git.confirmSync": false,
    "cmake.configureOnStart": false,
    "cmake.useCMakePresets": "auto",
    "cmake.buildDirectory": "${workspaceRoot}/_build/vs",
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "editor.accessibilitySupport": "off",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "cmake.configureOnEdit": false,
    "vim.easymotion": true,
    "vim.leader": "<space>",
    "vim.hlsearch": false,
    "vim.handleKeys": {
        "<C-p>": false
    },
    "remote.extensionKind": {
        "GitHub.copilot": [
            "workspace"
        ],
        "GitHub.copilot-chat": [
            "workspace"
        ]
    },
    "liveshare.allowGuestDebugControl": true,
    "liveshare.allowGuestTaskControl": true,
    "liveshare.languages.allowGuestCommandControl": true,
    "liveshare.openSharedServers": false,
    "liveshare.publishWorkspaceInfo": true,
    "workbench.editor.enablePreview": false,
    "workbench.colorTheme": "Dark+",
    "editor.lineNumbers": "relative",
    "githubPullRequests.pullBranch": "never",
    "vim.normalModeKeyBindingsNonRecursive": [
        { "before": [ "J" ], "after": [ "5", "j" ] },
        { "before": [ "K" ], "after": [ "5", "k" ] },
        { "before": [ "<C-h>" ], "after": [ "<C-w>", "h" ] },
        { "before": [ "<C-j>" ], "after": [ "<C-w>", "j" ] },
        { "before": [ "<C-k>" ], "after": [ "<C-w>", "k" ] },
        { "before": [ "<C-l>" ], "after": [ "<C-w>", "l" ] },
        { "before": [ "<A-,>" ], "commands": [ "workbench.action.navigateBack" ] },
        { "before": [ "<A-.>" ], "commands": [ "workbench.action.navigateForward" ] },
        { "before": [ "g", "r" ], "commands": [ "references-view.findReferences" ] },
        { "before": [ "<Leader>", "t", "t" ], "commands": [ ":tabnew" ] },
        { "before": [ "<Leader>", "t", "n" ], "commands": [ ":tabnext" ] },
        { "before": [ "<Leader>", "t", "p" ], "commands": [ ":tabprev" ] },
        { "before": [ "<Leader>", "t", "o" ], "commands": [ ":tabo" ] },
        { "before": [ "<Leader>", "o" ], "after": [ "o", "<Esc>" ] },
        { "before": [ "<Leader>", "O" ], "after": [ "O", "<Esc>" ] },
        { "before": [ "<Leader>", "j" ], "after": [ "J" ] },
        { "before": [ "<Leader>", "'" ], "commands": [ ":noh" ] },
        { "before": [ "<Leader>", "w" ], "commands": [ "workbench.action.files.save" ] },
        { "before": [ "<Leader>", "f" ], "commands": [ "editor.action.formatDocument" ] },
        { "before": [ "<Leader>", "p" ], "commands": [ "workbench.action.showCommands" ] },
        { "before": [ "<Leader>", "g" ], "commands": [ "workbench.action.gotoSymbol" ] },
        { "before": [ "<Leader>", "/" ], "commands": [ "editor.action.commentLine" ] },
        { "before": [ "<Leader>", "q" ], "commands": [ "openInIntegratedTerminal" ] },
        { "before": [ "<Leader>", "`" ], "commands": [ "workbench.action.terminal.toggleTerminal" ] },
        { "before": [ "<Leader>", "e" ], "commands": [ "workbench.view.explorer" ] },
        { "before": [ "<Leader>", "E" ], "commands": [ "workbench.view.git" ] },
        { "before": [ "<Leader>", "r" ], "commands": [ "editor.action.refactor" ] },
        { "before": [ "<Leader>", "1" ], "commands": [ "workbench.action.focusFirstEditorGroup" ] },
        { "before": [ "<Leader>", "2" ], "commands": [ "workbench.action.focusSecondEditorGroup" ] },
        { "before": [ "<Leader>", "r" ], "commands": [ "editor.action.rename" ] },
        { "before": [ "<Leader>", "h" ], "commands": [ "workbench.action.quickOpen" ] },
        { "before": [ "<Leader>", "<Leader>", "z" ], "commands": [ "workbench.panel.chat.view.copilot.focus" ] },
        { "before": [ "<Leader>", "n" ], "commands": [ "go-to-next-error.nextInFiles.warning" ] },
        { "before": [ "<Leader>", "N" ], "commands": [ "go-to-next-error.prevInFiles.warning" ] },
        { "before": [ "<Leader>", "s" ], "commands": [ "editor.action.marker.next" ] },
    ],
    "vim.sneak": true,
    "files.autoSave": "afterDelay",
    "[cmake]": {
        "editor.defaultFormatter": "loopj.vscode-gersemi"
    },
    "git.allowForcePush": true,
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Python Debugger: Current File with Arguments",
                "type": "debugpy",
                "request": "launch",
                "program": "${file}",
                "console": "integratedTerminal",
                "args": "${command:pickArgs}",
                "justMyCode": true
            }
        ]
    },
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "workbench.iconTheme": "vscode-icons",
    "cmake.default.buildDirectory": "${workspaceFolder}/_build/vscode",
    "git.enableSmartCommit": true,
    "[groovy]": {
        "editor.defaultFormatter": "NicolasVuillamy.vscode-groovy-lint"
    },
    "http.noProxy": [
        ""
    ],
    "cmake.configureOnStart": false,
    "cmake.configureOnOpen": false,
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "redhat.telemetry.enabled": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "black-formatter.args": [
        "--line-length",
        "100"
    ],
    "pasteImage.path": "${currentFileDir}/assets/${currentFileNameWithoutExt}",
    "dailyNotes.filePath": "C:/Users/svolkov/OneDrive - Advanced Micro Devices Inc/Documents/zettelkasten/daily-notes/daily-note.md",
    "editor.tokenColorCustomizations": {
        "[*Light*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#000"
                    }
                }
            ]
        },
        "[*Dark*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#fff"
                    }
                }
            ]
        },
        "textMateRules": [
            {
                "scope": "text.notes.info",
                "settings": {
                    "foreground": "#17a2b8",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "text.notes.success",
                "settings": {
                    "foreground": "#28a745",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "text.notes.warning",
                "settings": {
                    "foreground": "#ffc107",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "text.notes.danger",
                "settings": {
                    "foreground": "#dc3545",
                    "fontStyle": "bold"
                }
            }
        ]
    },
    "remote.SSH.remotePlatform": {
        "ctr2-mlse-smc-alola-s96-19": "linux",
        "ctr-cx63-mi300x-21": "linux",
        "personal-remote": "linux",
        "asrock-1w300-f0-1.adc.amd.com": "linux",
        "cv350-ccs-aus-h14-08.adc.amd.com": "linux",
        "ctr-cx63-mi300x-12.adc.amd.com": "linux",
        "quanta-ccs-aus-e15-19.adc.amd.com": "linux",
        "quanta-ccs-aus-j02-45.adc.amd.com": "linux",
        "asrock-1w300-f1-1": "linux"
    },
    "win-ca.inject": "append",
    "git.openRepositoryInParentFolders": "always",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "cpp": true
    },
    "chat.mcp.discovery.enabled": {
        "cursor-workspace": true,
        "cursor-global": true
    },
    "claudeCode.preferredLocation": "panel",
    "claudeCode.disableLoginPrompt": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "python.analysis.typeCheckingMode": "standard",
    "python.testing.pytestEnabled": true,
    "editor.largeFileOptimizations": false,
    "telemetry.feedback.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ]
}